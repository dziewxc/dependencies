{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "CET",
  "schedule": ["* 21 * * *"],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["* 21 * * *"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
